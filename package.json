{
  "name": "nimbus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "smoke": "node --env-file-if-exists=.env.local --import tsx scripts/smoke.mts",
    "seed": "node --env-file-if-exists=.env.local --import tsx scripts/seed.mts",
    "demo": "node --env-file-if-exists=.env.local --import tsx scripts/run.mts --yes",
    "demo:fast": "NIMBUS_MOCK_FAST=1 node --env-file-if-exists=.env.local --import tsx scripts/run.mts --yes",
    "demo:router": "node --env-file-if-exists=.env.local --import tsx scripts/router-ab.mts",
    "run:job": "node --env-file-if-exists=.env.local --import tsx scripts/job.mts",
    "check:loop": "NIMBUS_MOCK_FAST=1 NIMBUS_DEBUG_PROMPTS=1 node --env-file-if-exists=.env.local --import tsx scripts/loop-check.mts",
    "check:cron": "node --env-file-if-exists=.env.local --import tsx scripts/cron-check.mts",
    "eval": "node --env-file-if-exists=.env.local --import tsx scripts/eval.mts",
    "eval:ab": "node --env-file-if-exists=.env.local --import tsx scripts/eval.mts --ab",
    "demo:video": "node --env-file-if-exists=.env.local --import tsx scripts/record-demo.ts",
    "check:budget": "node --env-file-if-exists=.env.local --import tsx scripts/budget-check.mts",
    "check:learning": "NIMBUS_MOCK_FAST=1 NIMBUS_DEBUG_PROMPTS=1 node --env-file-if-exists=.env.local --import tsx scripts/check-learning.mts",
    "check:tools": "node --env-file-if-exists=.env.local --import tsx scripts/check-tools.mts",
    "seed:run": "node --env-file-if-exists=.env.local --import tsx scripts/seed-run.mts",
    "check:cases": "node --env-file-if-exists=.env.local --import tsx scripts/check-cases.mts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.79",
    "@base-ui/react": "^1.9.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@libsql/client": "^0.18.0",
    "@tavily/core": "^0.7.14",
    "ai": "^7.0.154",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "next": "15.5.28",
    "node-cron": "^4.6.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "playwright": "^1.64.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
