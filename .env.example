NIMBUS_MODEL=             # mock | nebius. Empty = nebius when NEBIUS_API_KEY is set, else the scripted mock model (no keys, $0)
NEBIUS_API_KEY=            # Nebius Token Factory key (https://tokenfactory.nebius.com)
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_PROJECT_ID=          # Token Factory project id (tokenfactory.nebius.com/project/api-keys). Set it and run_code runs in Nebius Sandboxes
NIMBUS_SANDBOX=             # local = never use Nebius Sandboxes even when the project id is set
NIMBUS_SANDBOX_IMAGE_PYTHON=python:3.12-slim   # public image tags the sandbox starts from
NIMBUS_SANDBOX_IMAGE_NODE=node:20-slim
TAVILY_API_KEY=            # Researcher agent search
REACTBITS_LICENSE_KEY=     # only to install UI blocks; not used at runtime
NIMBUS_DATA_DIR=./data     # SQLite file + run workspaces
NIMBUS_SEED_HISTORY=0       # 1 = write the demo seed (8 weeks of history, the recorded radar run) on the real models too. Mock mode always seeds it
NIMBUS_DEV_CHEAP=0         # 1 = route every agent to Nemotron Nano while developing
NIMBUS_API_TOKEN=          # bearer for /v1/chat/completions (OpenClaw / Hermes)
NIMBUS_ROUTER=on             # off = pin every hop to its role's ceiling tier
NIMBUS_PUBLIC_URL=           # base for run links in chat replies and Telegram messages (the phone cannot reach localhost); empty = the request's own origin
NIMBUS_USER_NAME=            # who drafted replies are from; the Writer signs with it. Empty = no signature (never "[Your Name]")
NIMBUS_V1_LOG=0              # 1 = write each /v1 request body to data/v1-log/ (authorization removed) to see what OpenClaw / Hermes send
NIMBUS_CHAT_QUESTION_WAIT_MS=600000   # how long a crew question waits for a chat answer before the crew picks the last option
NIMBUS_TELEGRAM_BOT_TOKEN=   # your own bot's token (docs/TELEGRAM.md); keep it in .env.local and Railway variables only
NIMBUS_TELEGRAM_CHAT_ID=     # the one chat the bot serves; send /start to the bot and the server log prints it
NIMBUS_TELEGRAM_MODE=poll    # poll = Nimbus reads its bot (buttons, /run, /status); off = OpenClaw owns the bot, Nimbus only sends
NIMBUS_TELEGRAM_API_BASE=    # tests only: a local stub standing in for https://api.telegram.org
